# WheelDeal settings. Is file ko ".env" naam se copy karo (setup.bat khud kar deta hai).
# ".env" mai passwords hote hain: isay kabhi git mai commit ya kisi ko share mat karo.

# ---- Option 1: SQLite (default, kuch install nahi karna) ----
# DATABASE_URL khali chor do to backend/wheeldeal.db file ban jayegi.
DATABASE_URL=

# ---- Option 2: MySQL (root use MAT karo, sirf is app ka alag limited user banao) ----
# MySQL mai (root se aik dafa) ye chalao, PASSWORD ki jagah lamba random password dalo:
#   CREATE DATABASE wheeldeal CHARACTER SET utf8mb4;
#   CREATE USER 'wheeldeal_app'@'localhost' IDENTIFIED BY 'STRONG_RANDOM_PASSWORD';
#   GRANT SELECT, INSERT, UPDATE, DELETE, CREATE, ALTER, INDEX ON wheeldeal.* TO 'wheeldeal_app'@'localhost';
#   FLUSH PRIVILEGES;
# Phir upar wali DATABASE_URL line comment karke ye likho:
# DATABASE_URL=mysql+pymysql://wheeldeal_app:STRONG_RANDOM_PASSWORD@localhost:3306/wheeldeal?charset=utf8mb4
# (Password mai @ : / # jaise special characters hon to URL-encode karo, ya unse bacho.)

# Secret key (optional, kam az kam 32 characters). Khali ho to automatically strong key
# banke backend/.secret_key mai save hogi. Khud banane ke liye:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WHEELDEAL_SECRET_KEY=

# ---- Login session ----
# Login ab HttpOnly cookie mai rehta hay (JavaScript chura nahi sakti). Kitne ghantay valid rahe
# (chota rakhna behtar hay, e.g. 8 ya 24; zyada se zyada 168 = 7 din). Logout par server foran session khatam kar deta hay.
TOKEN_EXPIRE_HOURS=24
# auto = HTTPS par Secure flag khud lagta hay. Server HTTPS proxy (nginx etc.) ke peeche ho to true likho.
COOKIE_SECURE=auto
# Sirf tab true karo jab server kisi trusted reverse proxy ke peeche ho (warna rate limit fake IP se bypass ho sakti hay).
TRUST_PROXY=false

# Real domain par deploy karo to yahan apni site likho, e.g. https://mysite.com
# Multiple ho to comma se alag karo. "*" ka matlab har website API use kar sakti hay (lekin cookies cross-site nahi chalti).
# Agar frontend alag port se kholte ho (VS Code Live Server) to likho: CORS_ORIGINS=http://127.0.0.1:5500
CORS_ORIGINS=*

# ---- Email verification ----
# true = signup ke baad email verify kiye bina login/ads nahi. SMTP set na ho to verification link
# server ke terminal (console) mai print hota hay (local testing ke liye).
# Pehle se bane hue users ko verified maana jata hay.
REQUIRE_EMAIL_VERIFICATION=true
# Verification link ka base URL (SMTP use karo to ZAROORI hay), e.g. https://mysite.com
PUBLIC_BASE_URL=
# SMTP (real email bhejne ke liye). Gmail: smtp.gmail.com, port 587, "App Password" use karo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false

# ---- Ads par limit (spam rokne ke liye) ----
MAX_ADS_PER_HOUR=5
MAX_ADS_PER_DAY=15
MAX_ADS_PER_USER=100
